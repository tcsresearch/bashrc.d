#!/bin/env bash

####################################################################################################
# FUNCTION CONFIGURATION #                                                                         #
####################################################################################################
  IS_ENABLED="1" # Can be: 1/0, Yes/No, YES/NO, True/False, or TRUE/FALSE                       

# Define Location of Cecho
Location_Cecho="/etc/BLING/Cecho.bfunc"


####################################################################################################
# BEGIN FUNCTION #                                                                                 #
####################################################################################################

# Load function if it exists
# TODO: Show error if not found.
if [ -f "$Location_Cecho" ]; then
    . "$Location_Cecho"
else
    echo "ERROR! Cecho Function Library $Location_Cecho NOT Found."
fi

